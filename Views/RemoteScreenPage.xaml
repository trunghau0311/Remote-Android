<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiRemoteAdb.Views"
             x:Class="MauiRemoteAdb.Views.RemoteScreenPage"
             Title="Remote Screen">
    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">

        <Grid x:Name="SurfaceContainer" Grid.Row="0" Grid.Column="0">
            <views:RemoteSurfaceView x:Name="Surface"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <FlexLayout x:Name="ButtonBar" Grid.Row="1" Grid.Column="0"
                    JustifyContent="Center" AlignItems="Center" Padding="10">
            <Button Text="◀ Back" Clicked="OnBackKeyClicked" Margin="4" />
            <Button Text="⬤ Home" Clicked="OnHomeKeyClicked" Margin="4" />
            <Button Text="▢ Recents" Clicked="OnRecentsKeyClicked" Margin="4" />
        </FlexLayout>

    </Grid>
</ContentPage>
